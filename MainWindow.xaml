<Window x:Class="ErhaGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ErhaGame"
        xmlns:converters="clr-namespace:ErhaGame.Converters"
        mc:Ignorable="d"
        Title="二哈游戏盒" Height="560" Width="860"
        Icon="pack://application:,,,/Assets/logo.png"
        AllowDrop="True" PreviewDrop="OnDrop" PreviewDragOver="OnDragOver"
        Background="#1E1E2E">

    <Window.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <converters:SecondsToPlayTimeConverter x:Key="SecondsToPlayTime"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3EB489"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/logo.png"
                   Width="44"
                   Height="44"
                   Stretch="UniformToFill"
                   VerticalAlignment="Center"/>
            <TextBlock Text="二哈游戏盒"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
            <Button Content="+ 添加游戏"
                    Margin="24,0,0,0"
                    Command="{Binding AddGameCommand}"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160"
                                    Margin="8"
                                    Background="#2A2A3C"
                                    CornerRadius="10"
                                    Padding="10"
                                    Cursor="Hand"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="启动游戏"
                                                  Command="{Binding Tag.LaunchGameCommand}"
                                                  CommandParameter="{Binding DataContext}"/>
                                        <MenuItem Header="更换封面"
                                                  Command="{Binding Tag.ChangeCoverCommand}"
                                                  CommandParameter="{Binding DataContext}"/>
                                        <Separator/>
                                        <MenuItem Header="删除游戏"
                                                  Command="{Binding Tag.DeleteGameCommand}"
                                                  CommandParameter="{Binding DataContext}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Border Width="140"
                                            Height="180"
                                            Background="#161625"
                                            CornerRadius="8">
                                        <Image Source="{Binding Cover}"
                                               Stretch="Uniform"
                                               Margin="8"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="14"
                                               Margin="0,8,0,0"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,4,0,0">
                                        <TextBlock Text="{Binding TotalPlaySeconds, Converter={StaticResource SecondsToPlayTime}}"
                                                   Foreground="#8A8A9A"
                                                   FontSize="12"/>
                                        <TextBlock Text="● 运行中"
                                                   Foreground="#3EB489"
                                                   FontSize="12"
                                                   Margin="6,0,0,0"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="把游戏的 .exe 文件拖进窗口，或点击「+ 添加游戏」"
                       Foreground="#8A8A9A"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="{Binding Games.Count, Converter={StaticResource CountToVisibility}}"/>
        </Grid>
    </Grid>
</Window>